{
  "name": "@luma/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain types and logic. No UI frameworks, no backend imports.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app-release": {
      "types": "./dist/app-release.d.ts",
      "default": "./dist/app-release.js"
    },
    "./wallpaper": {
      "types": "./dist/wallpaper.d.ts",
      "default": "./dist/wallpaper.js"
    },
    "./playlist": {
      "types": "./dist/playlist.d.ts",
      "default": "./dist/playlist.js"
    },
    "./playlist-edit": {
      "types": "./dist/playlist-edit.d.ts",
      "default": "./dist/playlist-edit.js"
    },
    "./live-wallpaper": {
      "types": "./dist/live-wallpaper.d.ts",
      "default": "./dist/live-wallpaper.js"
    }
  }
}
